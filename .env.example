#
# Bitrix24 BI Builder — On-Premise Configuration
#
# This file is copying with generate-env.sh.
# Keys and passwords in this file should not be used in production.
# All params marked with [REQUIRED] should be filled.
# Params with [GENERATED] are filled by generate-env.sh with secure random values.
#
# ───────────────────────────────────────────────────────────────────
# [REQUIRED] Connection to Bitrix24
# ───────────────────────────────────────────────────────────────────
# URL of yout Bitrix24 (e.g. https://mycompany.bitrix24.ru)
BX_PORTAL_URL=https://your-portal.bitrix24.ru
# Portal hostname (without https://, e.g. your-portal.bitrix24.ru)
BX_PORTAL_HOST=your-portal.bitrix24.ru
# IP of portal server. Default "host-gateway" works when portal is on the same host.
# Set to portal server IP if hostname is not resolvable from Superset server.
# BX_PORTAL_IP=
#
# Advanced: shared Docker network (only if portal and Superset containers
# need direct communication via Docker network, e.g. on the same host).
# BX_NETWORK_NAME=b24_bitrix
# BX_NETWORK_EXTERNAL=true
#
# ───────────────────────────────────────────────────────────────────
# [GENERATED] BI Builder access
# ───────────────────────────────────────────────────────────────────
# BI Builder admin password. Use generate-env.sh to generate a secure random value.
BI_BUILDER_ADMIN_PASSWORD=CHANGE_BI_BUILDER_ADMIN_PASSWORD
#
# ───────────────────────────────────────────────────────────────────
# [GENERATED] Secret keys
# ───────────────────────────────────────────────────────────────────
# BI Builder secret key. Use generate-env.sh to generate a secure random value.
BI_BUILDER_SECRET_KEY=CHANGE_ME_TO_A_COMPLEX_RANDOM_SECRET
#
# ───────────────────────────────────────────────────────────────────
# MySQL settings
# ───────────────────────────────────────────────────────────────────
DATABASE_DIALECT=mysql+mysqldb
DATABASE_HOST=bi_builder_mysql
DATABASE_PORT=3306
DATABASE_DB=superset
DATABASE_USER=superset
#
# ───────────────────────────────────────────────────────────────────
# [GENERATED] MySQL database access
# ───────────────────────────────────────────────────────────────────
# Superset user and root passwords for database. Use generate-env.sh to generate a secure random value.
DATABASE_PASSWORD=CHANGE_DATABASE_PASSWORD_SUPERSET
MYSQL_ROOT_PASSWORD=CHANGE_ROOT_PASSWORD_SUPERSET
#
# ───────────────────────────────────────────────────────────────────
# Redis
# ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
#
# ───────────────────────────────────────────────────────────────────
# Superset
# ───────────────────────────────────────────────────────────────────
# Docker network alias for Superset container. Only relevant with shared Docker network.
# SUPERSET_URL_ALIAS=superset.bi.local.bx
SUPERSET_PORT=8088
SUPERSET_LOG_LEVEL=info
#
# ───────────────────────────────────────────────────────────────────
# JWT / BX Security
# ───────────────────────────────────────────────────────────────────
SYMMETRIC_CRYPTO_KEY=GENERATED_SYMMETRIC_CRYPTO_KEY
#
# ───────────────────────────────────────────────────────────────────
# Trino
# ───────────────────────────────────────────────────────────────────
TRINO_HOST=nginx
TRINO_PORT=443
TRINO_SCHEME=https
# Trino JVM-memory. Increase if you have a lot of data and complex queries.
TRINO_JVM_XMS=1G
TRINO_JVM_XMX=4G
# Maximum time for query execution. Increase if you have a lot of data and complex queries.
TRINO_QUERY_MAX_RUN_TIME=5m
TRINO_QUERY_MAX_EXECUTION_TIME=5m
# Timeouts for connecting to Bitrix24 portal (in seconds)
BI_PORTAL_CONNECT_TIMEOUT=300
BI_PORTAL_WRITE_TIMEOUT=300
BI_PORTAL_READ_TIMEOUT=300
# Maximum number of concurrent requests. Increase if you have a lot of users and complex queries.
TRINO_MAX_REQUESTS_QUEUED=100
#
# ───────────────────────────────────────────────────────────────────
# [GENERATED] Trino access
# ───────────────────────────────────────────────────────────────────
# Trino access keys. Use generate-env.sh to generate a secure random value.
TRINO_CLIENT_KEY=CHANGE_TRINO_CLIENT_KEY
TRINO_PASS=CHANGE_TRINO_ADMIN_PASS
TRINO_INTERNAL_SECRET=CHANGE_TRINO_INTERNAL_SECRET
#
# ───────────────────────────────────────────────────────────────────
# Resource limits
# ───────────────────────────────────────────────────────────────────
# Increase these values if you have a lot of data, users, or complex queries.
# Format: memory — Docker notation (256m, 1g, 2g), cpus — decimal (0.5, 1.0, 2.0),
#         pids/nofile/nproc — integers.
#
# Trino (query engine — most likely needs scaling first)
TRINO_MEM_LIMIT=4g
TRINO_CPUS=2.0
TRINO_PIDS_LIMIT=1000
TRINO_NOFILE_SOFT=4096
TRINO_NOFILE_HARD=8192
TRINO_NPROC_SOFT=8192
TRINO_NPROC_HARD=8192
#
# Superset (app, worker, beat, init)
SUPERSET_MEM_LIMIT=2g
SUPERSET_CPUS=1.0
SUPERSET_PIDS_LIMIT=150
SUPERSET_NOFILE_SOFT=1024
SUPERSET_NOFILE_HARD=2048
#
# Nginx
NGINX_MEM_LIMIT=256m
NGINX_CPUS=0.5
NGINX_PIDS_LIMIT=100
NGINX_NOFILE_SOFT=1024
NGINX_NOFILE_HARD=2048
#
# Redis
REDIS_MEM_LIMIT=256m
REDIS_CPUS=0.5
REDIS_PIDS_LIMIT=50
REDIS_NOFILE_SOFT=1024
REDIS_NOFILE_HARD=2048
#
# MySQL
DATABASE_MEM_LIMIT=1g
DATABASE_CPUS=1.0
DATABASE_PIDS_LIMIT=200
DATABASE_NOFILE_SOFT=4096
DATABASE_NOFILE_HARD=8192
#
# ───────────────────────────────────────────────────────────────────
# Python / internal settings. Usually, you don't need to change these.
# ───────────────────────────────────────────────────────────────────
PYTHONPATH=/app/pythonpath
PYTHONUNBUFFERED=1
COMPOSE_PROJECT_NAME=bi_builder
FLASK_APP=superset.app:create_app()
#
